# Copy this file to .env and fill in your values.

# SQLite (default for 48h). Swap to PostgreSQL for production:
# DATABASE_URL=postgresql://user:pass@db:5432/screening
DATABASE_URL=sqlite:///./screening.db

# ChromaDB persistent storage directory
CHROMA_PERSIST_DIR=./chroma_data

# LLM provider: "groq" (default, free), "anthropic", or "openai"
LLM_PROVIDER=groq

# Get a free Groq key at console.groq.com (no credit card required)
GROQ_API_KEY=your_groq_api_key_here

# Model name — pin to a stable ID, not a preview alias
# Groq: llama-3.3-70b-versatile (higher quality) or llama-3.1-8b-instant (faster, higher throughput)
LLM_MODEL=llama-3.3-70b-versatile

# Local sentence-transformer model (downloaded automatically on first run)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Interview configuration
MAX_QUESTIONS_PER_INTERVIEW=6
RETRIEVAL_TOP_K=4

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:3000
